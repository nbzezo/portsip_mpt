{
  "name": "portsip-cc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensible Contact Center application plane integrated with PortSIP",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @portsip-cc/api --filter @portsip-cc/worker --filter @portsip-cc/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:unit && pnpm run test:architecture",
    "test:unit": "vitest run",
    "test:architecture": "node scripts/check-architecture.mjs && node scripts/check-architecture-fixtures.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
